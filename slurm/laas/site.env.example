# Cluster-specific settings for slurm/laas/submit_reference.sh.
# Copy to site.env (gitignored) next to this file and fill in; never commit site.env.

# sbatch helper script sourced by the submit script and the job.
SBATCH_HELPER=/path/to/sbatchHelpers.sh
# Dataset root as the compute nodes see it; the shaped AMASS Clips are in $DATA_ROOT/amass_shaped/{train,test}.
DATA_ROOT=/path/to/datasets/priorformer
# Where runs are written: $RESULTS_ROOT/<run>/ with logs in logs/.
RESULTS_ROOT=/path/to/work/priorformer_results
# Optional command run at job start to sync the dataset (leave empty to skip).
DATASYNC=
